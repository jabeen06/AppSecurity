PORT=4000
# Optional: match "today" for upcoming meetings to your school (e.g. Asia/Kolkata). Defaults to server OS timezone.
# TZ=Asia/Kolkata

JWT_SECRET=change-me-in-prod

# School-only access policy (email must end with this domain)
ALLOWED_DOMAIN=@arborinternationalschool.com

# Supabase PostgreSQL
#
# If you see: "Can't reach database server at db....supabase.co:5432"
#   1) Supabase Dashboard → your project: if it is PAUSED, click "Restore" / resume.
#   2) Settings → Database → copy the URI again (password reset if unsure).
#   3) Password special chars: @ → %40, # → %23, etc.
#   4) Always append: ?sslmode=require (or &sslmode=require if the URI already has ?)
#   5) Firewall/VPN/school network may block outbound 5432 — try another network or hotspot.
#
# Direct (migrations / Prisma db push):
#   postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
#
# Optional — Transaction pooler (port 6543), sometimes works when 5432 is blocked:
#   Use the "Pooler" or "Transaction" connection string from Supabase (includes pgbouncer).
#   For Prisma + pooler you may need directUrl in schema.prisma for migrations; see Prisma Supabase guide.
#
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_ENCODED@db.laygkafgvzrelocxvjpu.supabase.co:5432/postgres?sslmode=require"

# One-time bootstrap token to create the first AdminList record
# (Set this once, run /api/admin/bootstrap, then you can remove/rotate it)
INITIAL_ADMIN_SETUP_TOKEN=change-me-in-prod
