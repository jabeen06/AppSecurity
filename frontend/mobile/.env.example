# Copy to .env in this folder, then restart Expo:  npx expo start -c
#
# Must be your BACKEND (Express) base URL ending in /api — same as web VITE_API_BASE_URL.
# NOT the Vercel site (e.g. app-security-kappa.vercel.app).
#
# Physical phone + API on your laptop:
#   - Do NOT use localhost (that is the phone itself).
#   - Use http://YOUR_PC_LAN_IP:4000/api  (ipconfig / ifconfig on PC; same Wi‑Fi as phone).
#
# Emulator: Android use http://10.0.2.2:4000/api ; iOS Simulator can use http://localhost:4000/api
#
# Production options:
#   - Direct API: https://your-api.onrender.com/api
#   - Or same proxy as the website (after Vercel has BACKEND_URL set):
#     EXPO_PUBLIC_API_BASE_URL=https://app-security-kappa.vercel.app/api

EXPO_PUBLIC_API_BASE_URL=http://192.168.1.XXX:4000/api
