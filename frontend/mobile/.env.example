# Copy to .env and restart Expo (`npx expo start -c`).
#
# This must be your BACKEND API base — the same URL you set as VITE_API_BASE_URL for the web app.
# Example: https://your-api.onrender.com/api
#
# Wrong: https://your-app.vercel.app  (that is the website; it returns HTML, not /auth/login JSON.)

EXPO_PUBLIC_API_BASE_URL=https://YOUR_API_HOST/api
